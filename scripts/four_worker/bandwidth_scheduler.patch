+    def select_waiting(self, scheduler, native_queue):
+        request = native_queue.peek_request()
+        if self.light_limit_Bps is None:
+            return native_queue, request
+        # A new heavy request at the native head gets an opportunity to
+        # acquire. A refusal in this step instead prioritizes light requests.
+        # Already allocated and blocked requests retain native handling.
+        if request.num_computed_tokens or request.request_id in self.permits:
+            return native_queue, request
+        if not self.rejected_this_step and self.hint(request)["is_heavy_read"]:
+            return native_queue, request
+
+        candidates = []
+        for queue in (scheduler.skipped_waiting, scheduler.waiting):
+            for candidate in queue:
+                if scheduler._is_blocked_waiting_status(candidate.status):
+                    continue
+                hint = self.hint(candidate)
+                if not hint["is_heavy_read"]:
+                    candidates.append((queue, candidate, hint.get("pressure_Bps", 0.0)))
+        if not candidates:
+            return native_queue, request
+
+        limit = self.light_limit_Bps
+        fits = [item for item in candidates if item[2] <= limit]
+        if fits:
+            queue, selected, pressure = min(fits, key=lambda item: (
+                -item[2], item[1].arrival_time))
+        else:
+            queue, selected, pressure = min(candidates, key=lambda item: (
+                item[2], item[1].arrival_time))
+        self.log("bandwidth_light_selected", request_id=selected.request_id,
+                 pressure_Bps=pressure, limit_Bps=limit, fitted=bool(fits),
+                 remaining_Bps=self.remaining_Bps,
+                 source="current_denial" if self.rejected_this_step else "previous_denial")
+        return queue, selected
+
+    def pop_selected(self, queue, request):
+        if request is queue.peek_request():
+            return queue.pop_request()
+        queue.remove_request(request)
+        return request
 
