+def check_bandwidth_ledger(events, records, hints, permits, config):
+    limit = config['admission']['reference_bandwidth_Bps']
+    share = limit / config['workers']
+    thresholds = {e['threshold_version']: e['theta'] for e in events
+                  if e['event'] == 'threshold_updated'}
+    for rid, hint in hints.items():
+        demand = records[rid]['profile']['pressure_Bps']
+        theta = thresholds[hint['threshold_version']]
+        assert hint['pressure_Bps'] == round(demand)
+        assert hint['is_heavy_read'] == (demand > share and theta is not None and demand >= theta)
+    active = {}
+    peak = 0.
+    oversized = 0
+    for e in events:
+        before = math.fsum(active.values())
+        if e['event'] in ('admission_reserved', 'read_permit_denied'):
+            demand = hints[e['id']]['pressure_Bps']
+            assert e['pressure_Bps'] == demand and e['budget_Bps'] == limit
+            assert math.isclose(e['held_Bps_before'], before)
+            allowed = not active or before + demand <= limit
+            if e['event'] == 'read_permit_denied':
+                assert not allowed
+                assert e['held_Bps'] == e['held_Bps_before']
+                assert math.isclose(e['remaining_Bps'], max(0., limit - before))
+                continue
+            assert allowed and not permits[e['permit_id']]['forced']
+            assert permits[e['permit_id']]['pressure_Bps'] == demand
+            assert e['oversized_alone'] == (not active and demand > limit)
+            oversized += int(e['oversized_alone'])
+            active[e['id']] = demand
+            after = math.fsum(active.values())
+            assert math.isclose(e['held_Bps_after'], after)
+            peak = max(peak, after)
+        elif e['event'] == 'admission_released':
+            del active[e['id']]
+    assert not active
+    return dict(bandwidth_budget_Bps=limit, fair_share_Bps=share,
+                peak_held_Bps=peak, oversized_alone_grants=oversized, final_held_Bps=0.)
 
 
