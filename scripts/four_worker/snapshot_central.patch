+def check_prefill_ledger(status, config):
+    hints, records = status['storage_hints'], status['records']
+    for rid, hint in hints.items():
+        assert hint['pressure_Bps'] == round(records[rid]['profile']['pressure_Bps'])
+    if config['admission'].get('force_light'):
+        assert not any(hint['is_heavy_read'] for hint in hints.values())
+        assert not status['permits']
+    version, ignored, forced = 0, 0, 0
+    started, active = set(), {}
+    for event in status['events']:
+        kind = event['event']
+        if kind == 'prefill_start_ignored':
+            ignored += 1
+            continue
+        if kind not in ('prefill_started', 'prefill_ended'):
+            continue
+        version += 1
+        assert event['version'] == version
+        rid = event['id']
+        if kind == 'prefill_started':
+            assert rid not in started
+            expected = hints[rid]['pressure_Bps'] if event.get('external_load', True) else 0
+            assert event['pressure_Bps'] == expected
+            assert records[rid]['worker_id'] == event['worker']
+            active[rid] = event
+            started.add(rid)
+            forced += int(event['forced'])
+        else:
+            start = active.pop(rid)
+            assert event['worker'] == start['worker'] and event['pressure_Bps'] == start['pressure_Bps']
+            assert event['reason'] in ('first_token', 'request_finished')
+    assert not active and not status['active_prefill']
+    assert version == status['prefill_snapshot_version']
+    return dict(prefill_registered=len(started), prefill_forced=forced,
+                prefill_late_notices=ignored, prefill_snapshot_version=version)
+
