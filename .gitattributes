# Keep Linux entry points and reproducible inputs unchanged on Windows clones.
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
# This benchmark hashes its README as part of the frozen payload.
/benchmark/synthetic_abc_360_6s_12_90GBps/README.md text eol=lf
# Preserve raw runtime output, including trailing blanks emitted by dependencies.
*.log -whitespace
