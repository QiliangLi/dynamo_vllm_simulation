  "cards": [
    {
      "dot": "cyan",
      "title": "调度公式（default.rs:282-388）",
      "items": [
        "logit = s·P′ + D + w·A；argmin logit，平局 softmax 采样",
        "P′ = 投影 prefill 块 − overlap 折扣（device/host/disk 三层）；信用启用时改用 max(0, D−credit) + w·A",
        "本仿真：credit=0、温度=0 → cache-blind 基线（仅 A、P）"
      ]
    },
    {
      "dot": "amber",
      "title": "公式因子怎么获取",
      "items": [
        "A / P / D：网关生命周期记账（reserve / prefill_complete / add_output_block / free），零滞后投影",
        "overlap 折扣：KV 事件（ZMQ）→ 三层索引（事件滞后、引擎真相）；请求字段随请求携带，本仿真未接 add_output_block"
      ]
    },
    {
      "dot": "rose",
      "title": "公式外交互（图中虚线）",
      "items": [
        "etcd 服务发现：定候选集合，不进公式",
        "FPM 每步事件 → Planner：含 waiting 队列，只喂 SLA 扩缩容",
        "token 流回程是数据面；记账更新搭回程流的车"
      ]
    }
  ]
