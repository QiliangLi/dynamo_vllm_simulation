  "cards": [
    {
      "dot": "cyan",
      "title": "调度公式（策略族代表）",
      "items": [
        "load-balance：score = (running + λ·queued) / EWMA(输出tps) × (1 + α·(1−kv_free)²)；kv_free<10% 直接出局",
        "prefix-cache 默认混合：5·prefix_match + 4·load_balance 归一加权；standalone：max 匹配 + running ≤ mean+k·σ，回退 least-request",
        "兜底：KV 缺失=按全空闲、TPS 未知=他 pod 均值；slo-least-load-pulling 现拉新鲜快照"
      ]
    },
    {
      "dot": "amber",
      "title": "公式因子怎么获取",
      "items": [
        "running / queued / kv_free：PromQL 查 Prometheus（抓 vLLM /metrics），有抓取间隔滞后",
        "EWMA 吐出速率 / 在途请求：网关自记账（零滞后，回程流更新）",
        "prefix_match：默认=网关路由历史哈希表（投影，LRU 20 万块/20 分钟过期）；可选=KV 事件同步（引擎真相）"
      ]
    },
    {
      "dot": "rose",
      "title": "公式外交互（图中虚线）",
      "items": [
        "Redis 跨网关副本共享索引（STATESYNC）；autoscaler 滑动窗聚合在控制面",
        "session-affinity / P/D / SLO 策略族：另行选择，不改基础打分",
        "负载失衡前置门控在所有策略前统一收窄候选"
      ]
    }
  ]
