  "cards": [
    {
      "dot": "cyan",
      "title": "三条通道，没有同步查询",
      "items": [
        "逐请求路由打分只吃：网关在途记账 + KV 事件索引；FPM（含 waiting 队列）只喂扩缩容不进路由",
        "三家都没有热路径查询：都是订阅/抓取 → 本地缓存 → 打分"
      ]
    },
    {
      "dot": "amber",
      "title": "对照：llm-d 与 AIBrix",
      "items": [
        "llm-d：KV 事件（ZMQ）+ 重放缓冲；AIBrix：PromQL 抓 running/queued/KV 进路由打分",
        "AIBrix 默认前缀索引 = 路由历史投影；KV 事件同步模式才是引擎真相"
      ]
    },
    {
      "dot": "violet",
      "title": "对仿真工程的意义",
      "items": [
        "P1 StepBatch 事件流 = FPM 模式（scheduler-cls 注入 → 每步发布 → 控制器消费）在虚拟时钟下的重建",
        "观测通道要带 epoch / 滞后语义：AIBrix 失真教训与 llm-d 重放缓冲是旁证"
      ]
    }
  ]
