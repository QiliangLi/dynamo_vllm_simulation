  "cards": [
    {
      "dot": "cyan",
      "title": "调度公式（EPP 插件链三步）",
      "items": [
        "① TokenProducer：调 Render 服务（vLLM /v1/*/render）精确 tokenize → token 块序列",
        "② PrefillAffinityFilter：候选 = 前缀块常驻的 Ready pod；暖集吞吐饱和（> peakPrefillThroughput）回退低载",
        "③ TokenLoadScorer：argmin 在途 token 负载（路由计入、完成释放）"
      ]
    },
    {
      "dot": "amber",
      "title": "公式因子怎么获取",
      "items": [
        "前缀常驻集合：KV 事件（ZMQ 5556）→ 每 EPP 副本独立索引；ROUTER 5559 重放缓冲供重启重建",
        "在途 token：EPP 本进程自记账，零滞后——不是引擎内部队列（故此模式 EPP 单副本）",
        "token 块：精确 tokenize（含工具渲染），非本地估算"
      ]
    },
    {
      "dot": "rose",
      "title": "公式外交互（图中虚线）",
      "items": [
        "discoverPods / Ready 门控：候选集合控制，不进打分",
        "重放缓冲是恢复机制；索引本身才是公式因子",
        "放置层（K8s scheduler 插件）不在逐请求路径；不抓引擎指标进路由"
      ]
    }
  ]
